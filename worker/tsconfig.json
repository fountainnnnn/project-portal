{
  // The root tsconfig excludes worker/ — it is a DOM+React project and this is
  // not. Same strictness, different lib and different globals: no `document`,
  // no `vite/client`, and D1Database / Fetcher / ExecutionContext supplied by
  // @cloudflare/workers-types.
  //
  // `npm run build` does not reach this file (tsc -b builds the root project
  // only), so type-check the Worker explicitly:
  //   npx tsc -p worker --noEmit
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts"]
}
