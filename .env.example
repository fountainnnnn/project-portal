# ── Skill-tag generation ────────────────────────────────────────────────────
# DeepSeek today. To move to OpenAI later, set AI_PROVIDER=openai and supply
# OPENAI_API_KEY — nothing else in the app changes.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Optional overrides. Left blank, each provider uses its own default model
# (deepseek-chat / gpt-4o-mini).
# AI_MODEL=
# AI_BASE_URL=

# ── Seed accounts ───────────────────────────────────────────────────────────
# Used once, only when the account does not already exist. Set these before
# first run to avoid the printed development defaults.
SEED_ADMIN_EMAIL=admin@dsac.sp.edu.sg
SEED_ADMIN_PASSWORD=admin1234
SEED_STAFF_EMAIL=staff@sp.edu.sg
SEED_STAFF_PASSWORD=staff1234

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_PORT=5173
# STORAGE_DIR=./data
