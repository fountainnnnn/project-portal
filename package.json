{
  "name": "project-portal",
  "version": "0.1.0",
  "private": true,
  "description": "SP DSAC project portal — publishes DSAC projects so staff can find and express interest in them",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c red,blue \"npm:server\" \"npm:client\"",
    "client": "vite --host 0.0.0.0",
    "server": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.mjs",
    "build": "tsc -b && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "preview": "concurrently -k -n backend,frontend -c red,blue \"npm:server\" \"vite preview --host 0.0.0.0\"",
    "lint": "eslint .",
    "cf:schema": "wrangler d1 execute project-portal --file=worker/schema.sql",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "hono": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.11",
    "wrangler": "^4.45.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
